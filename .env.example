PORT=5400
NODE_ENV=production
JWT_SECRET=change-me-in-prod

# Master Hub — API adresi (PANEL DEĞİL!).
# hub.mdayazilim.com = yönetim paneli (frontend), hub-api.mdayazilim.com = API.
HUB_URL=https://hub-api.mdayazilim.com
APP_API_KEY=dm_restoran_b8f4d2a1e3c5

# QR kodlarına gömülen taban URL — müşteri menüsünün (frontend) adresi.
# QR okutunca buraya gider: <QR_PUBLIC_BASE>/m/<slug>/<token>
QR_PUBLIC_BASE=https://restoran.mdayazilim.com

# Hub'ın satın alma onayında geri çağıracağı webhook tabanı.
# Seçenek A'da bu backend'in KENDİ public adresidir (frontend değil).
PUBLIC_BACKEND_URL=https://restoran-api.mdayazilim.com

# CORS — boş bırakılırsa tüm origin'lere açık (Bearer-token auth, CSRF riski yok).
# Kısıtlamak istersen: CORS_ORIGINS=https://restoran.mdayazilim.com
CORS_ORIGINS=

LICENSE_CHECK_INTERVAL_MIN=60

# SMTP — boş bırakılırsa OTP konsola yazılır (geliştirme modu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=MDA Restoran POS

# Root (ekosistem yoneticisi) paneli — /root adresinden girilir.
# IKISI DE BOSSA root kullanicisi HIC olusmaz ve panel kapali kalir (guvenli varsayilan).
# Parola en az 10 karakter olmali, aksi halde kurulmaz.
ROOT_EMAIL=
ROOT_PASSWORD=

# ————— SofraMix POS provizyonu —————
# POS, SofraMix'e periyodik olarak "yeni onaylanmis POS paketi odemesi var mi"
# diye sorar; her yeni odeme icin kiraci acar ya da lisansi 1 yil uzatir.
# IKISI DE BOSSA bu dongu HIC calismaz (guvenli varsayilan) ve acilista
# "[provizyon] kapali" yazar. YALNIZ BIRI doluysa acikca HATA basar - bu
# neredeyse her zaman yazim hatasidir.
SOFRAMIX_PLATFORM_URL=
# SofraMix root panelinden uretilir (Yonetim > Ayarlar > Platform anahtarlari).
# 'smxp_' ile baslar ve YALNIZCA uretildigi an bir kez gorunur.
SOFRAMIX_PLATFORM_ANAHTAR=
# Aktivasyon baglantisinin gonderilecegi arayuz adresi.
POS_PANEL_URL=https://restoran.mdayazilim.com
# Kac saniyede bir sorulacak (varsayilan 180).
POS_PROVIZYON_ARALIK_SN=180
# Genis tur: saatte bir kez bu kadar saat geriye donup tekrar sorar (atlama olmasin).
POS_PROVIZYON_CAKISMA_SAAT=6
POS_PROVIZYON_GENIS_ARALIK_DK=60
# Hic kayit yokken ilk turda kac gun geriye bakilacak (SofraMix en fazla 400 gune izin verir).
POS_PROVIZYON_ILK_GUN=90
# Elle cozulmesi gereken odeme, kirik baglanti veya gonderilemeyen posta
# uyarilarinin gidecegi adres. Bossa yalnizca sunucu gunlugune yazilir.
PROVIZYON_UYARI_EPOSTA=
PROVIZYON_UYARI_SINIRI=5

# Pazaryeri kimlik bilgilerinin sifrelenmesi (AES-256-GCM).
# 32 baytlik base64 anahtar. Bos birakilirsa kanal anahtari KAYDEDILEMEZ.
MARKETPLACE_KEK=
